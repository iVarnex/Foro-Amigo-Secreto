# Neon Postgres (Vercel Marketplace: vercel integration add neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk (Vercel Marketplace: vercel integration add clerk) - solo para /admin
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"

# Admin allowlist — solo esta cuenta de Clerk puede entrar a /admin
ADMIN_EMAIL="admin@example.com"
